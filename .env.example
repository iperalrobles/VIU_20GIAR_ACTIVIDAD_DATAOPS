# Copy this file as .env and fill real values when needed.
# Do not commit .env.

# Alpha Vantage API key. The ETL works with deterministic mock data if this is demo.
ALPHA_VANTAGE_API_KEY=demo

# ETL outputs
DB_PATH=data/stocks.db
JSON_OUTPUT_PATH=public/data/stocks.json

# Optional frontend fallback if the generated dataset is unavailable.
VITE_ALPHA_VANTAGE_KEY=demo
